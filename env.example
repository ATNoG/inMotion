# Copy to .env and fill in. `.env` is gitignored — never commit real values.
#
#   cp env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a      # or use direnv / your shell profile

# --- Weights & Biases (training logs) -------------------------------------
# A key was previously committed in job_*.sh and must be treated as leaked:
# rotate it at https://wandb.ai/authorize and use the new value here.
WANDB_API_KEY=
WANDB_ENTITY=andreribeiro87-universidade-de-aveiro

# --- Demo: router access ------------------------------------------------
# The demo SSHes into the access point to read RSSI.
INMOTION_ROUTER_IP=
INMOTION_ROUTER_USER=root
INMOTION_ROUTER_PASS=
INMOTION_ROUTER_KEY_FILE=
INMOTION_ROUTER_PORT=22
INMOTION_ROUTER_COMMAND_MODE=auto

# --- Demo: model and fallback data --------------------------------------
INMOTION_MODEL_PATH=models/GaussianProcess.joblib
INMOTION_FALLBACK_CSV=dataset_only_pure.csv
INMOTION_SCAN_INTERVAL=1.0

# --- Bus map basemap (optional) -----------------------------------------
# A CARTO API key lets `inmotion bus demand` draw real basemap tiles under the
# generated flows. Without it the page draws the timetable's own leg geometry
# instead — no key, no third party, works offline.
#
# Note the query parameter CARTO actually reads is `key`; `api_key` returns a
# tile that says "API KEY REQUIRED" whatever the key is.
#
# The key ends up inside the generated HTML page (that is how a client-side
# basemap key works), so a scenario built with it should not be committed.
CARTO_API_KEY=
