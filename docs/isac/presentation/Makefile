SRC := presentation.md

LATEX_ENGINE := lualatex
PANDOC := pandoc -t beamer -s --slide-level=2 --pdf-engine=$(LATEX_ENGINE)

# generated by make_figures.py (transparent-background copies of the paper figures)
GEN_FIGURES := \
    images/rssi_trajectory.pdf \
    images/transfer_mcc.pdf \
    images/feature_importance_18ch.pdf

ASSETS := \
    images/fig_setup.pdf \
    images/real_env.jpg \
    images/smart_bus.png


# Install
# If you do not have the ATNoG theme, you need to clone the theme repo here under assets
# Licensing...
TEXMFHOME  := $(shell kpsewhich -var-value=TEXMFHOME)
DESTDIR    := $(TEXMFHOME)/tex/latex/beamerATNoG
THEME_FOLDER := ./assets/templates/presentation/latex
BRAND := $(THEME_FOLDER)/../../../brand
THEME_FILES := $(THEME_FOLDER)/* \
               $(BRAND)/logos/pdf/* \
               $(BRAND)/partners/* \

TARGETS := p.pdf p-notes.pdf

.PHONY: all install figures clean

all: $(TARGETS)

install: $(THEME_FILES)
	@mkdir -p "$(DESTDIR)"
	cp $(THEME_FILES) "$(DESTDIR)/"
	texhash "$(TEXMFHOME)" >/dev/null
	@echo "Installed ATNoG beamer theme to $(DESTDIR)"
	@echo "\\usetheme{ATNoG} now works from any .tex file on this system."

figures: $(GEN_FIGURES)

$(GEN_FIGURES): make_figures.py
	uv run python make_figures.py

p.pdf: $(SRC) $(ASSETS) $(GEN_FIGURES)
	$(PANDOC) -o $@ $(SRC)

p-notes.pdf: $(SRC) $(ASSETS) $(GEN_FIGURES)
	$(PANDOC) -V classoption=notes=only -o $@ $(SRC)

clean:
	rm -f $(TARGETS)
