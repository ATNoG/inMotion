SRC := presentation.md

LATEX_ENGINE := lualatex
PANDOC := pandoc -t beamer -s --slide-level=2 --pdf-engine=$(LATEX_ENGINE)

# generated by make_figures.py (transparent-background copies of the paper figures)
GEN_FIGURES := \
    images/rssi_trajectory.pdf \
    images/transfer_mcc.pdf \
    images/feature_importance_18ch.pdf

ASSETS := \
    images/fig_setup.pdf \
    images/real_env.jpg \
    images/smart_bus.png

TARGETS := p.pdf p-notes.pdf

.PHONY: all figures clean

all: $(TARGETS)

figures: $(GEN_FIGURES)

$(GEN_FIGURES): make_figures.py
	uv run python make_figures.py

p.pdf: $(SRC) $(ASSETS) $(GEN_FIGURES)
	$(PANDOC) -o $@ $(SRC)

p-notes.pdf: $(SRC) $(ASSETS) $(GEN_FIGURES)
	$(PANDOC) -V classoption=notes=only -o $@ $(SRC)

clean:
	rm -f $(TARGETS)
